# Caddyfile — Tunnd behind Caddy with manual TLS certificates
#
# This is the recommended production setup for Tunnd.
# Caddy terminates TLS (using certs you provide) and proxies
# traffic to the Tunnd server on the internal network.
#
# Replace "tunnd.example.com" with your actual domain throughout.
# Replace cert paths with the actual paths on your server.
#
# How it works (single internal port — the recommended layout):
#   - tunnd.example.com        → admin dashboard, served by tunnd itself
#                                 on the base domain of its HTTP port
#   - *.tunnd.example.com      → tunnel traffic
#   - /_tunnd/control          → WebSocket control plane
#
# The admin port (9091) stays loopback-bound — it is not proxied at all.
# Set TUNND_HTTP_PORT=9095 in tunnd-server's config (any non-443 port
# disables tunnd's own TLS; Caddy handles TLS here).

# ── Base domain: admin dashboard + control plane ─────────────────────────────
tunnd.example.com {
    tls /etc/caddy/certs/tunnd/fullchain.pem /etc/caddy/certs/tunnd/privateKey.pem

    # tunnd routes by Host itself: the bare base domain goes to the admin
    # dashboard, /_tunnd/control to the control plane.
    reverse_proxy tunnd-server:9095 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── Wildcard tunnel subdomains ────────────────────────────────────────────────
*.tunnd.example.com {
    tls /etc/caddy/certs/tunnd/fullchain.pem /etc/caddy/certs/tunnd/privateKey.pem

    reverse_proxy tunnd-server:9095 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }
}
