# Build stage
FROM golang:1.25-alpine AS builder

# Pure-Go build (modernc.org/sqlite) — no toolchain dependencies needed.

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/tunnd-server \
    ./cmd/server

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM alpine:latest AS runtime

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata wget

# Create non-root user and group with UID/GID 1000
RUN addgroup -g 1000 tunnd && \
    adduser -D -u 1000 -G tunnd tunnd

# Create /data directory and set ownership to tunnd user
RUN mkdir -p /data && chown -R tunnd:tunnd /data

# Copy binary from builder stage
COPY --from=builder /out/tunnd-server /usr/local/bin/tunnd-server

# Switch to non-root user
USER tunnd

VOLUME ["/data"]
EXPOSE 80 443 9091

# Health check: verify server is responding on the admin port. Uses
# TUNND_ADMIN_PORT when set so the probe follows operator overrides
# (compose files commonly remap admin to 9096 to leave 9091 for
# Prometheus etc.). Falls back to the binary default of 9091.
HEALTHCHECK --interval=5s --timeout=3s --retries=3 --start-period=5s \
  CMD ["sh", "-c", "wget -qO- http://localhost:${TUNND_ADMIN_PORT:-9091}/healthz || exit 1"]

ENTRYPOINT ["/usr/local/bin/tunnd-server"]
CMD ["--config", "/data/tunnd-server.yaml"]
