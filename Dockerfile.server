# Build stage
FROM golang:1.25-alpine AS builder

# gcc + musl-dev needed for CGO (mattn/go-sqlite3)
RUN apk add --no-cache gcc musl-dev

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /out/tunnd-server \
    ./cmd/server

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM alpine:latest AS runtime

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata wget

# Create non-root user and group with UID/GID 1000
RUN addgroup -g 1000 tunnd && \
    adduser -D -u 1000 -G tunnd tunnd

# Create /data directory and set ownership to tunnd user
RUN mkdir -p /data && chown -R tunnd:tunnd /data

# Copy binary from builder stage
COPY --from=builder /out/tunnd-server /usr/local/bin/tunnd-server

# Switch to non-root user
USER tunnd

VOLUME ["/data"]
EXPOSE 80 443 9091

# Health check: verify server is responding on admin port
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD wget -qO- http://localhost:9091/api/stats || exit 1

ENTRYPOINT ["/usr/local/bin/tunnd-server"]
CMD ["--config", "/data/tunnd-server.yaml"]
